# Copy to apps/web/.env.local. Everything is optional: without keys the app runs on its built-in rules engine.

# AI (turns on AI scoring and AI agent replies)
AI_API_KEY=
# Model used for scoring and replies (default: standard)
AI_MODEL=

# Public URL of this app. Used for QR codes and webhook links when deployed or tunnelled.
APP_URL=

# n8n (optional): lets "Deploy" create the workflow in your n8n instance automatically
N8N_URL=
N8N_API_KEY=

# Search by business name (optional; free web search is used without it)
BRAVE_SEARCH_API_KEY=

# Twilio (optional): lets owner replies go out on WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
