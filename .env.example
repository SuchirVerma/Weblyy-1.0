# Copy to apps/web/.env.local. Everything is optional: without keys the app runs on its built-in rules engine.

# AI replies (optional). Add one or more keys. They are tried in this order, and when one runs out of free
# quota or fails the next one takes over. With no keys, or when all of them fail, the rules engine answers.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional: change the order, or the model a provider uses (GROQ_MODEL, GEMINI_MODEL, ...)
AI_PROVIDERS=

# Public URL of this app. Used for QR codes and webhook links when deployed or tunnelled.
APP_URL=

# n8n (optional): lets "Deploy" create the workflow in your n8n instance automatically
N8N_URL=
N8N_API_KEY=

# Search by business name. Free engines work from a laptop but block cloud servers (Vercel),
# so set one of these when deployed. Serper.dev: 2,500 free Google searches, no card.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Twilio (optional): lets owner replies go out on WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
