{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/api/scan/route.js": {
      "memory": 2048
    },
    "src/app/api/makeover/[scanId]/route.js": {
      "memory": 2048
    },
    "src/app/api/workspace/route.js": {
      "memory": 2048
    },
    "src/app/api/search/route.js": {
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/cron/outbox",
      "schedule": "0 6 * * *"
    }
  ]
}
